{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosys Gemini Research Response",
  "type": "object",
  "required": [
    "ok",
    "result"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "concept",
        "sections"
      ],
      "properties": {
        "concept": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "topic",
              "content"
            ],
            "properties": {
              "topic": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
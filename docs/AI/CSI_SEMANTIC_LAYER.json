{
  "schema_version": "1.0",
  "id": "diagnosis_csi_semantic_layer",
  "name": "CSI Semantic Layer for Diagnosis",
  "status": "architecture_derived_from_current_CSI_repository",
  "purpose": "Fornecer ao Diagnosis uma camada semantica inspirada no CSI para normalizar diferentes formas de linguagem clinica em unidades semanticas estaveis, sem transformar linguagem em diagnostico automaticamente.",
  "architectural_principle": {
    "core_idea": "O sistema nao deve depender da palavra exata utilizada pelo paciente, medico ou formulario. Deve reconhecer variacoes linguisticamente equivalentes ou relacionadas e encaminha-las para uma representacao semantica canonica.",
    "separation": {
      "document_structure": "Onde a informacao esta.",
      "semantic_content": "O que a informacao significa.",
      "clinical_reasoning": "O que essa informacao pode significar clinicamente.",
      "diagnosis": "Conclusao clinica que deve permanecer separada da normalizacao semantica."
    },
    "pipeline": [
      "raw_language",
      "normalization",
      "candidate_semantic_units",
      "canonical_anchors",
      "patient_state",
      "clinical_model",
      "possibility_engine",
      "clinical_reasoning"
    ]
  },
  "non_negotiable_rules": [
    "CSI nao diagnostica.",
    "CSI nao deve substituir o raciocinio clinico.",
    "Uma expressao de linguagem natural nao deve ser convertida em diagnostico apenas porque aparece associada a um diagnostico em uma lista lexical.",
    "Preservar a diferenca entre sintoma, sinal, achado, campo documental, investigacao, tratamento e diagnostico.",
    "Quando uma expressao for ambigua, retornar candidatos ou marcar ambiguidade em vez de inventar uma interpretacao.",
    "Nao apagar o texto original: a forma original deve permanecer disponivel para auditoria e contexto.",
    "A ancora canonica representa identidade semantica; nao representa por si so causalidade, gravidade ou diagnostico.",
    "A mesma unidade semantica pode aparecer em diferentes formularios, idiomas e interfaces.",
    "O conhecimento clinico continua pertencendo a Knowledge Base e ao Clinical Model.",
    "O Patient State representa o estado verdadeiro do paciente; a camada CSI apenas ajuda a interpretar a linguagem que alimenta esse estado."
  ],

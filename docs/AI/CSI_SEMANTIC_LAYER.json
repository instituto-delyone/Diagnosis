  "semantic_record_model": {
    "raw_text": "Texto original recebido pelo sistema.",
    "normalized_text": "Texto normalizado para comparacao sem alterar o original.",
    "language": "Idioma detectado ou informado.",
    "document_anchor": "Ancora estrutural opcional, por exemplo 002.001.",
    "semantic_anchor": "Ancora de conteudo opcional, por exemplo SYM.003.",
    "canonical_term": "Nome canonico associado a ancora.",
    "match_type": "exact | lexical_variant | popular_variant | abbreviation | multilingual_variant | ambiguous | unknown",
    "confidence": "Valor de 0 a 1 para a correspondencia semantica.",
    "evidence": "Termo ou regra que justificou a correspondencia.",
    "original_preserved": true,
    "clinical_inference": "Nao preenchido pela camada CSI.",
    "diagnosis": "Nao preenchido pela camada CSI."
  },
  "processing_algorithm": {
    "step_1": "Preservar a entrada original.",
    "step_2": "Normalizar apenas para comparacao: caixa, espacos e variacoes ortograficas seguras.",
    "step_3": "Identificar o contexto estrutural quando houver: queixa, HDA, exame, sinais vitais, investigacao etc.",
    "step_4": "Pesquisar primeiro correspondencias exatas nas formas canonicas.",
    "step_5": "Pesquisar sinonimos, variacoes populares, abreviacoes e variantes linguisticamente equivalentes.",
    "step_6": "Mapear a expressao para uma ou mais ancoras semanticas candidatas.",
    "step_7": "Se houver mais de uma interpretacao plausivel, manter candidatos e marcar ambiguidade.",
    "step_8": "Produzir uma representacao estruturada sem apagar o texto original.",
    "step_9": "Entregar a representacao ao Patient State / Clinical Model.",
    "step_10": "Deixar o raciocinio clinico, diferencial e diagnostico para as camadas clinicas."
  },

  "compound_patterns": [
    {
      "pattern_id": "pedido_sinais_vitais_completo",
      "examples": [
        "me passa os sinais vitais",
        "quais os sinais vitais atuais",
        "como estão os sinais vitais"
      ],
      "must_resolve_as": "sinais_vitais",
      "response_strategy": "retornar FC, FR, PA, SpO2, temperatura e glicemia quando disponíveis no Patient State",
      "do_not": "não retornar apenas PA por correspondência lexical isolada"
    },
    {
      "pattern_id": "pedido_exame_respiratorio",
      "examples": [
        "como está a ausculta pulmonar",
        "exame respiratório",
        "como estão os pulmões"
      ],
      "must_resolve_as": "exame_respiratorio",
      "response_strategy": "consultar physical_exam.respiratory e retornar apenas achados presentes/reveláveis"
    },
    {
      "pattern_id": "pergunta_qualitativa_hemodinamica",
      "examples": [
        "está hemodinamicamente estável?",
        "como está hemodinamicamente?"
      ],
      "must_resolve_as": "sintese_hemodinamica",
      "response_strategy": "avaliar conjunto de sinais disponíveis no Patient State; não reduzir automaticamente a PA"
    }

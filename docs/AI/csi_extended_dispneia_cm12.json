  "ambiguity_rules": [
    {
      "input_examples": [
        "chiado",
        "cansaço",
        "falta de ar"
      ],
      "rule": "Mapear primeiro para sintoma/sinal; não inferir asma ou DPOC sem dados clínicos adicionais."
    },
    {
      "input_examples": [
        "pressão",
        "pressão boa"
      ],
      "rule": "Se não houver contexto suficiente para pressão arterial, pedir esclarecimento; evitar captura automática de qualquer menção a 'pressão'."
    },
    {
      "input_examples": [
        "como estão os pulmões?"
      ],
      "rule": "Interpretar como pedido de exame respiratório/síntese respiratória, não como diagnóstico."
    },
    {
      "input_examples": [
        "isso é TEP?"
      ],
      "rule": "Tratar como solicitação de avaliação diagnóstica; consultar possibilidades e evidências do Patient State/Clinical Model, sem converter a pergunta em confirmação automática."
    }
  ],

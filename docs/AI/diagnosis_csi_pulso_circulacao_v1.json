  "compositional_rules": [
    {
      "id": "CSI_COMP_VITAL_SIGN_VALUE",
      "input_pattern": "FIND.011 + valor numérico",
      "output": "FIND.011(value, unit=mmHg)",
      "note": "O valor deve ser preservado como atributo; não converter automaticamente em diagnóstico."
    },
    {
      "id": "CSI_COMP_HEART_RATE_VALUE",
      "input_pattern": "FIND.012 + valor numérico + bpm",
      "output": "FIND.012(value, unit=bpm)",
      "note": "A classificação clínica do valor pertence à Knowledge Base/Clinical Model."
    },
    {
      "id": "CSI_REL_CONFLICT",
      "input_pattern": "SIGN.011(absent) + FIND.011(measurable)",
      "output": "RELATION(conflict=true)",
      "note": "Representar a contradição e encaminhar para reconfirmação; não resolver semanticamente por conta própria."
    }
  ],
  "example_transformations": [
    {
      "input": "Não estou encontrando pulso central.",
      "document_context": "003.000.",
      "semantic_anchor": "SIGN.011",
      "canonical": "Pulso Central",

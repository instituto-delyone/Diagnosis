{
  "schema_version": "1.0",
  "id": "diagnosis_csi_pulso_circulacao",
  "name": "CSI — Pulso, Circulação e Inconsistência Hemodinâmica",
  "status": "draft",
  "purpose": "Adicionar ancoragem semântica para expressões relacionadas a pulso, circulação, pressão arterial, frequência cardíaca e dados conflitantes, sem transformar linguagem em diagnóstico.",
  "architectural_principle": {
    "core_idea": "Normalizar a linguagem para unidades semânticas estáveis e entregar essas unidades ao Patient State e à Knowledge Base.",
    "separation": {
      "document_structure": "Onde o dado aparece.",
      "semantic_content": "O que o dado representa.",
      "clinical_reasoning": "O que a combinação dos dados pode exigir como investigação.",
      "diagnosis": "Conclusão clínica permanece fora da camada CSI."
    },
    "pipeline": [
      "raw_language",
      "normalization",
      "candidate_semantic_units",
      "canonical_anchors",
      "patient_state",
      "clinical_model",
      "clinical_reasoning"
    ]
  },
  "non_negotiable_rules": [
    "CSI não diagnostica.",
    "CSI não deve substituir o raciocínio clínico.",
    "Preservar o texto original.",
    "Uma expressão ambígua deve permanecer ambígua até que o contexto clínico a resolva.",
    "Uma âncora semântica não representa causalidade ou gravidade por si só.",
    "Contradição entre unidades deve ser representada como relação, não apagada por normalização."
  ],
  "anchor_families": {
    "documental": {
      "description": "Campos estruturais do caso.",
      "examples": [
        "003.001. Sinais Vitais",
        "003.000. Exame Físico Geral e Segmentar",
        "005.000. Investigação Complementar Solicitada"
      ]
    },
    "semiological": {
      "description": "Unidades clínicas reconhecíveis.",
      "examples": [
        "SIGN.011 Pulso Central",
        "FIND.011 Pressão Arterial Mensurável",
        "FIND.012 Frequência Cardíaca",
        "STATE.011 Circulação Presente",
        "RULE.011 Inconsistência Clínica"
      ]
    }
  },
  "semantic_record_model": {
    "raw_text": "Texto original.",
    "normalized_text": "Texto normalizado somente para comparação.",
    "language": "Idioma.",
    "document_anchor": "Âncora documental opcional.",
    "semantic_anchor": "Âncora semântica.",
    "canonical_term": "Termo canônico.",
    "match_type": "exact | lexical_variant | popular_variant | abbreviation | multilingual_variant | ambiguous | unknown",
    "confidence": "0 a 1",
    "evidence": "Evidência lexical/contextual.",
    "original_preserved": true,
    "clinical_inference": "Não preenchido automaticamente pela CSI.",
    "diagnosis": "Não preenchido pela CSI."
  },

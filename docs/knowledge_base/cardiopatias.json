  "clinical_rules": [
    {
      "id": "rule_sca_ecg",
      "name": "Investigação inicial da síndrome coronariana aguda",
      "type": "diagnostic_rule",
      "if": [
        "dor torácica ou equivalente isquêmico",
        "suspeita clínica de síndrome coronariana aguda"
      ],
      "then": [
        "obter eletrocardiograma",
        "avaliar marcadores de lesão miocárdica quando indicados",
        "avaliar estabilidade clínica",
        "estratificar risco"
      ]
    },
    {
      "id": "rule_iam_supra_reperfusao",
      "name": "IAM com supradesnivelamento exige avaliação imediata para reperfusão",
      "type": "management_rule",
      "if": [
        "quadro clínico compatível",
        "ECG compatível com IAM com supradesnivelamento"
      ],
      "then": [
        "acionar estratégia de reperfusão apropriada sem atrasos desnecessários",
        "avaliar contraindicações e contexto"
      ]
    },
    {
      "id": "rule_ic_congestao",
      "name": "Insuficiência cardíaca aguda com congestão",
      "type": "management_rule",
      "if": [
        "sinais ou sintomas de congestão",
        "insuficiência cardíaca aguda"
      ],
      "then": [
        "avaliar oxigenação e ventilação",
        "avaliar pressão arterial e perfusão",
        "considerar diurese em contexto apropriado",
        "identificar fator precipitante"
      ]
    },
    {
      "id": "rule_taquiarritmia_instavel",
      "name": "Taquiarritmia com instabilidade",
      "type": "emergency_rule",
      "if": [
        "taquiarritmia",
        "instabilidade hemodinâmica atribuível à arritmia"
      ],
      "then": [
        "avaliar cardioversão elétrica sincronizada quando indicada",
        "realizar suporte clínico apropriado"
      ]
    },
    {
      "id": "rule_pcr_chocavel",
      "name": "Parada cardiorrespiratória em ritmo chocável",
      "type": "emergency_rule",
      "if": [
        "parada cardiorrespiratória",
        "fibrilação ventricular ou taquicardia ventricular sem pulso"
      ],
      "then": [
        "iniciar RCP",
        "desfibrilar conforme algoritmo",
        "continuar suporte avançado",
        "investigar causas reversíveis"
      ]
    },
    {
      "id": "rule_pcr_nao_chocavel",
      "name": "Parada cardiorrespiratória em ritmo não chocável",
      "type": "emergency_rule",
      "if": [
        "parada cardiorrespiratória",
        "atividade elétrica sem pulso ou assistolia"
      ],
      "then": [
        "iniciar RCP",
        "seguir algoritmo de ritmo não chocável",
        "investigar causas reversíveis"
      ]
    },
    {
      "id": "rule_tep_risco",
      "name": "Estratificação de risco no tromboembolismo pulmonar",
      "type": "risk_rule",
      "if": [
        "suspeita ou diagnóstico de tromboembolismo pulmonar"
      ],
      "then": [
        "avaliar estabilidade hemodinâmica",
        "avaliar disfunção ventricular direita",
        "avaliar biomarcadores quando indicados",
        "classificar risco para orientar tratamento"
      ]
    },
    {
      "id": "rule_dissection_aortica",
      "name": "Síndrome aórtica aguda",
      "type": "emergency_rule",
      "if": [
        "suspeita clínica de síndrome aórtica aguda"
      ],
      "then": [
        "reduzir estresse hemodinâmico conforme contexto",
        "obter imagem apropriada sem atrasos indevidos",
        "acionar avaliação especializada"
      ]
    },
    {
      "id": "rule_endocardite_culturas",
      "name": "Investigação microbiológica da endocardite",
      "type": "diagnostic_rule",
      "if": [
        "suspeita clínica de endocardite infecciosa"
      ],
      "then": [
        "obter hemoculturas adequadas antes da antibioticoterapia quando clinicamente possível",
        "realizar investigação ecocardiográfica",
        "avaliar complicações"
      ]
    }
  ],


  "clinical_patterns": {
    "diagnosis": {
      "threshold": "PAS >=140 mmHg ou PAD >=90 mmHg, com confirmação conforme gravidade e contexto clínico.",
      "confirmation": "Em geral, 2 a 3 medidas em consultas separadas por 1 dia a 4 semanas; HAS grau 1 requer confirmação com duas medições com intervalo de 7 a 14 dias.",
      "immediate_consultation": "PA >=160/100 mmHg.",
      "single_consultation_context": "PA >=180/110 mmHg ou evidência de doença cardiovascular ou lesão de órgão-alvo."
    },
    "classification": [
      {"name":"otima","pas":"<120","pad":"<80"},
      {"name":"normal","pas":"120-129","pad":"80-84"},
      {"name":"normal_alta","pas":"130-139","pad":"85-89"},
      {"name":"HAS_grau_1","pas":"140-159","pad":"90-99"},
      {"name":"HAS_grau_2","pas":"160-179","pad":"100-109"},
      {"name":"HAS_grau_3","pas":">=180","pad":">=110"}
    ],
    "out_of_office": ["white_coat_hypertension","masked_hypertension"]
  },
  "investigations": [
    {"id":"office_bp","clinical_question":"Qual é a pressão arterial medida adequadamente em consultório?","possible_outputs":["ótima","normal","normal alta","HAS grau 1","HAS grau 2","HAS grau 3"]},
    {"id":"abpm_hbpm","clinical_question":"A pressão permanece elevada fora do consultório?","methods":["MAPA","MRPA"],"uses":["hipertensão do avental branco","hipertensão mascarada"]},
    {"id":"baseline_evaluation","clinical_question":"Há fatores de risco, lesão de órgão-alvo ou comorbidades relevantes?","tests":["sódio","potássio","creatinina","TFGe","albuminúria","perfil lipídico","glicemia de jejum","análise de urina","ECG"]}
  ],
  "risk_stratification": {
    "context":"Indivíduos com PA normal alta ou HAS sem doença cardiovascular pré-estabelecida.",
    "annual_context":"O PCDT recomenda avaliação anual do RCV em indivíduos de 40 a 74 anos e cita a calculadora HEARTS/OPAS/OMS como a que apresentou melhor calibração para a população brasileira entre as avaliadas.",
    "inputs":["idade","sexo","tabagismo","diabetes","PAS","colesterol total quando disponível","peso e altura quando colesterol não disponível","DCV","DRC"]
  },
  "treatments": [
    {"id":"lifestyle","type":"non_pharmacological","components":["alimentação adequada e saudável","redução do sódio","controle do peso","atividade física regular","redução ou cessação de bebidas alcoólicas","cessação do tabagismo","manejo do estresse","qualidade do sono"]},
    {"id":"pharmacological","type":"pharmacological","selection_factors":["grau da HAS","risco cardiovascular","comorbidades","indicações específicas","contraindicações","contexto clínico"],"classes":["IECA","BRA","BCC","diuréticos tiazídicos e similares","betabloqueadores"]},
    {"id":"resistant_hypertension","type":"pharmacological","context":"Após confirmação de adesão e otimização terapêutica; o PCDT contempla espironolactona no contexto de HAS resistente."}
  ],
  "clinical_rules": [
    {"id":"has_degree_1","if":{"pas":"140-159","pad":"90-99"},"then":"HAS grau 1"},
    {"id":"has_degree_2","if":{"pas":"160-179","pad":"100-109"},"then":"HAS grau 2"},
    {"id":"has_degree_3","if":{"pas":">=180","pad":">=110"},"then":"HAS grau 3"},
    {"id":"high_normal","if":{"pas":"130-139","pad":"85-89"},"then":"PA normal alta"},
    {"id":"immediate_consultation","if":"PA >=160/100 mmHg","then":"consulta médica imediata conforme PCDT"}
  ],
